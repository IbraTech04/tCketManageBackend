<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibrasoft</groupId>
        <artifactId>tcketmanage-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tcketmanage-core</artifactId>
    <name>tcketmanage-core</name>
    <description>tCketManage core: ticketing entities, repositories, services, controllers, payments,
        crypto, email and SVG rendering. Packaged as a plain library jar with a gated
        Spring Boot auto-configuration so it can be embedded in any host application.</description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.integration</groupId>
            <artifactId>spring-integration-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- LOAD-BEARING — do NOT delete this as a "redundant pin that Boot's BOM manages".
             It is neither redundant nor BOM-managed, and removing it breaks ticket rendering at
             runtime, not at compile time.

             Why it isn't transitive: spring-boot-starter-thymeleaf pulls thymeleaf-spring6, and
             thymeleaf-spring6's POM explicitly <exclusion>s ognl from thymeleaf-core, because in
             Spring mode Thymeleaf evaluates ${...} with SpEL and genuinely doesn't need it. But
             SvgTemplateConfig deliberately builds a plain org.thymeleaf.TemplateEngine (not a
             SpringTemplateEngine) for the XML/SVG ticket templates — and the plain engine's
             expression evaluator IS the OGNL-backed one. So core needs a jar its own starter
             deliberately excludes, which only an explicit declaration can supply.

             Why the BOM can't own it: spring-boot-dependencies has no entry for ognl:ognl, so with
             this block gone nothing puts it on the classpath at all. Verified: deleting it makes
             TicketGenerationServiceTest and TicketQrIntegrationTest fail with
             NoClassDefFoundError: ognl/PropertyAccessor on the first ${...} in the SVG template.

             Why 3.3.4: that is the exact version thymeleaf-parent 3.1.5.RELEASE declares as
             <ognl.version>, i.e. the version this Thymeleaf is built and tested against. When
             upgrading Thymeleaf (normally via a Spring Boot bump), re-read that property and match
             it here rather than picking the newest OGNL release. -->
        <dependency>
            <groupId>ognl</groupId>
            <artifactId>ognl</artifactId>
            <version>3.3.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Brings the @PreAuthorize annotation + SecurityContext only (NOT spring-security-web).
             Core declares authorization *intent*; enforcement is the host's: a host with method
             security enabled (e.g. LensBridge) honours these annotations, while the standalone
             tcketmanage-app enables nothing, so they stay inert and the app is fully open. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-all</artifactId>
            <version>1.19</version>
        </dependency>

        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.2</version>
        </dependency>

        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.2</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>

        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.8</version>
        </dependency>

        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>33.1.0</version>
        </dependency>

    </dependencies>

    <!-- No spring-boot-maven-plugin here: core is a plain library jar, not a repackaged
         executable. The standalone executable is produced by the tcketmanage-app module. -->

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>keys/**</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

</project>